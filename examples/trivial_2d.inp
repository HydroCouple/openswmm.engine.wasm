[TITLE]
Trivial 2D: rain on a 100 m x 100 m sloped plane, draining through one edge

[OPTIONS]
FLOW_UNITS           CMS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2024
START_TIME           00:00:00
END_DATE             01/01/2024
END_TIME             02:00:00
REPORT_STEP          00:05:00
WET_STEP             00:05:00
DRY_STEP             00:05:00
ROUTING_STEP         5

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
RG1     INTENSITY  0:05      1.0  TIMESERIES STORM

[TIMESERIES]
;;Name  Time  Value (mm/hr)
;; Each value lasts one gage interval (0:05): 30 minutes of 50 mm/hr = 25 mm.
STORM   0:00  50
STORM   0:05  50
STORM   0:10  50
STORM   0:15  50
STORM   0:20  50
STORM   0:25  50

[2D_OPTIONS]
;;Parameter  Value
DRY_DEPTH    0.001
REPORT_2D    YES

[2D_VERTICES]
;;X     Y      Z (m)
0.0     0.0    0.0
100.0   0.0    0.0
100.0   100.0  1.0
0.0     100.0  1.0

[2D_TRIANGLES]
;;V1  V2  V3  Manning_n  Init_depth
0     1   2   0.03       0.0
0     2   3   0.03       0.0

[2D_BOUNDARY_CONDITIONS]
;;Tri  Edge  Type         Param_1  Param_2  Group
;; Edge e is opposite vertex e: triangle 0 edge 2 is (v0, v1), the low south side.
0      2     NORMAL_FLOW  0.01     *        *
