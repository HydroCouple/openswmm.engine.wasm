{
  "name": "@hydrocouple/openswmm-engine-wasm",
  "version": "6.0.0-alpha.4",
  "description": "WebAssembly bindings for the OpenSWMM Engine C++ API — mirrors the openswmm.engine Python bindings surface.",
  "license": "Apache-2.0",
  "author": "Caleb Buahin <caleb.buahin@gmail.com>",
  "homepage": "https://github.com/HydroCouple/openswmm.engine.wasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HydroCouple/openswmm.engine.wasm.git"
  },
  "bugs": {
    "url": "https://github.com/HydroCouple/openswmm.engine.wasm/issues"
  },
  "keywords": [
    "swmm",
    "openswmm",
    "stormwater",
    "hydrology",
    "hydraulics",
    "webassembly",
    "wasm",
    "emscripten"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./raw": {
      "import": "./dist/raw.js",
      "types": "./dist/raw.d.ts"
    },
    "./wasm": {
      "import": "./dist/openswmm_engine.js"
    },
    "./openswmm_engine.wasm": "./dist/openswmm_engine.wasm"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "gen": "python3 tools/gen_bindings.py && python3 tools/gen_fields.py && python3 tools/gen_python_surface.py",
    "configure:wasm": "emcmake cmake -B build -DCMAKE_BUILD_TYPE=Release",
    "build:wasm": "cmake --build build --parallel",
    "build:ts": "tsc --project tsconfig.json",
    "build": "npm run build:ts && node tools/copy_catalog_defaults.mjs",
    "test": "vitest run",
    "smoke": "node tests/smoke/exports.mjs && node tests/smoke/smoke.mjs && node tests/smoke/fileio.mjs && node tests/smoke/junction_storage.mjs && node tests/smoke/snow_factors.mjs && node tests/smoke/smoke2d.mjs && node tests/smoke/hdf5.mjs && node tests/smoke/groundwater.mjs && node examples/trivial_2d.mjs && node tests/smoke/checkpoint.mjs",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:bindings": "bash tools/host_shim/check.sh",
    "prepublishOnly": "node -e \"for (const f of ['dist/openswmm_engine.wasm','dist/openswmm_engine.js','dist/index.js']) require('fs').accessSync(f)\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:py": "ruff check tools && ruff format --check tools",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:py && npm test",
    "docs:api": "typedoc --options docs/typedoc.config.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false
}
